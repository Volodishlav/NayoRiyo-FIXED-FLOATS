extends SpriteChar;
zOrder=0;
p=$pat_item+38;
while(1){
  x=x+1;
  y=y-sin(a)*10;
  a=a+10;
  
  if($buki==3){
    if ( crashTo( $target )) {
      if ( $target.shoot == 1 ) {
        $score=$score+1;
        p=$pat_item+39;
        wait(5);
        die();
    }}
  }
  if(x>=350){
    $message=14;
    $projectmanager.loadpage($page_gameover);
  }
  
  update();
}