extends text;
$screenWidth = 32*(31/2);
$screenHeight = 32*(53/5);
$map.setBGColor(color(10,10,10));
n=0;
while(1){
  
  if($end==6){
    if(n==0){
      wait(50);
      $se=1;
      wait(100);
      message("いやぁああ！！#やだ！！殺さないで！！#やだぁ！",4);
      message("なよりちゃん、はやくしなさい。#りよなちゃんに会いたいでしょ？@その子を消せば#少なくともりよなちゃんと#いっしょにいさせてあげるわよ。",4);
      $kao.f=1;$kao.sw=1;message("……………。",4);$kao.sw=0;
      message("なにためらってるのよ。#さんざん私の仲間を殺しといて#できないっていうの？@早くしないとりよなちゃん#取り返しのつかないことに#なってるかもよ？",4);
      $kao.sw=1;message("……………##……わかり…ました。",5);$kao.sw=0;
      message("ひぃ！！#助けてぇ！殺さないでぇ！！",4);
      $kao.sw=1;message("………ごめんなさい。",5);$kao.sw=0;
      $haribote2.a=1;
      wait(30);
      $die_nayori.n=1;
      n=1;
    }
    if(n==1){}
    if(n==2){
      $kao.sw=2;message("ごめんなさいごめんなさいごめんなさい#ごめんなさいごめんなさいごめんなさい#ごめんなさいごめんなさいごめんなさい#ごめんなさいごめんなさいごめんなさい",3);$kao.sw=0;
    }
    if($die_riyona.i>15){
      n=1;
      wait(50);
      $die_nayori.n=2;
      wait(100);
      $kao.sw=3;message("…終わりました。",5);$kao.sw=0;
      wait(30);
      message("何言ってるの？#まだ終わってないじゃない。",4);
      $die_nayori.n=3;
      $kao.f=-1;$kao.sw=4;message("え…#だって…殺せって…",5);$kao.sw=0;
      message("私は殺せなんて言ってないわ。#消せと言っているのよ#この場から。",4);
      $kao.sw=4;message("そんな…#消せってどうやって…",5);$kao.sw=0;
      message("そうねぇ。#ナイフだけじゃ大変だから#フォークも必要かしらね。",4);
      $kao.sw=4;message("………まさか！？",4);$kao.sw=0;
      message("そ、残さず消すのよ。#なよりちゃん。",4);
      $die_nayori.a=1;
      $kao.sw=4;message("そんなこと…##…できません。",4);$kao.sw=0;
      message("あら残念。#りよなちゃんの方は大丈夫かしらね。#彼ら手加減ってもの知らないからなぁ。",4);
      $kao.sw=4;message("っ……………やりますから。@お姉ちゃんを…#助けてあげてください…#お願いします…",5);$kao.sw=0;
      $die_nayori.n=4;
      $die_nayori.a=0;
      wait(50);
      $die_nayori.n=5;
      wait(200);
      $kao.f=1;$kao.sw=5;message("むぐぅ…ぐぅ…うっ…ぐむっ……",5);$kao.sw=0;
      message("うわーほんとに食べてる。#気持ちわるーい。",4);
      wait(50);
      $kao.sw=5;message("うぅ…ひどい…ぐふぅ…",5);$kao.sw=0;
      wait(50);
      $die_nayori.n=6;
      $kao.sw=5;message("うっ！！",2);$kao.sw=0;
      $die_nayori.n=7;
      $kao.sw=5;message("おえぇぇ！！",4);$kao.sw=0;
      wait(30);
      message("誰が吐いていいなんて言ったの。#ちゃんと食べなさい。",4);
      wait(30);
      $die_nayori.n=8;
      $kao.sw=5;message("はい…うぅ…",4);$kao.sw=0;
      $die_nayori.n=5;
      wait(100);
      $se=6;
      wait(200);
      $die_riyona.n=3;
      $gomonkan.x=520;
      $gomonkan.y=245;
      $se=1;
      wait(200);
      $gomonkan.n=1;
      wait(200);
      message("あら。#けっこうはかどってるじゃない。",4);
      $kao.sw=5;message("うぅ…ぐむぅ…うぐ…むぐ…",5);$kao.sw=0;
      message("なよりちゃんが#がんばってるようだから、#ご褒美を持ってきの。#ちょっと休んでいいわよ。",4);
      $die_nayori.n=9;
      wait(50);
      $kao.f=-1;$kao.sw=6;message("ぐぷぅ…なん…ですか…",5);$kao.sw=0;
      message("りよなちゃんも#私の所で飼ってあげようと思って#買い取った人達に#話をつけにいったのよ。@でもあっちも#お気に入りみたいでなかなか#手放してくれそうもなくてさぁ。@でも安心して。#なんとか交渉できたから。",5);
      $gomonkan.n=2;
      wait(20);
      $mplayer.play($se_dosa);
      wait(30);
      $die_nayori.a=3;
      $kao.sw=6;message("なんですか…コレ…？",5);$kao.sw=0;
      message("いいから開けてご覧なさい。",4);
      $die_nayori.n=10;
      wait(200);
      $die_nayori.a=4;
      $kao.sw=7;message("ひっ！！@おねえ…！？",5);$kao.sw=0;
      message("彼ら穴さえあれば生きてようが#死んでようがいいみたいでさ。#だからいらない部分をもらってきたの。@ふふっ#これでまた姉妹仲良く#一緒にいられるでしょ。@あ、目玉は生きてる時に#すでに刳り抜かれてて#私がやったんじゃないから許してね。",4);
      $kao.sw=7;message("い…いやぁ……",4);$kao.sw=0;
      $kao.sw=7;message("いやぁぁぁぁ！！！！！！！",3);$kao.sw=0;
      wait(30);
      $se=5;
      wait();
    }
  }
  
  if($end==7){
    wait(50);
    message2("冷たく、湿気のある薄暗い部屋に#なよりとりよなはいた。@服を脱がされた上に、穴のあいた板に手と首を挟まれ#身動きが取れない状態であった。@不安と恐怖で青ざめ、震えている様子は、#まるでギロチンを待つ死刑囚のようである。",4);
    message2("「お二人とも…いや、失礼。#　なよりさん、これが何だか分かりますか？」",4);
    message2("目の前には若い男が立っている。@仮面をかぶっているため、#彼がどんな表情をしているかはわからないが、#おそらく笑っているのであろう。",4);
    $cg.a=1;
    $cg2.a=1;
    wait(200);
    message2("「…ネズミ。」",6);
    message2("「はい、その通り。正解です。」",5);
    message2("そう言うと男は手に持っていたネズミを#なよりの鼻先まで持ってきた。@ネズミは歯をギラつかせ、#なよりに噛みつこうと暴れだす。",4);
    message2("「ひぃ！いやぁ！！」",3);
    message2("「なより！？」",5);
    message2("「おっと…まだおあずけですよ。」@「なよりさん#　この船に放されているネズミは少し特殊でしてね。」@「私たち組織が品種改良と調教によって生み出した、#　生きた人間の肉が大好物のネズミなんですよ。」",5);
    message2("「に…人間の…！？」",3);
    message2("「……私たちに…何をする気ですか…」",5);
    message2("二人の会話で状況を理解したりよなは頭に#最悪の事をよぎりながらも恐る恐る男に尋ねた。",5);
    message2("「今あなた達の後ろには数日前から餌を与えていない#　ネズミが何十匹といます。」@「これからちょうど餌の時間でしてね。#　今日のメニューは”双子の踊り食い”#　ご馳走だと思いませんか。」",5);
    message2("「いやぁぁ！！！やだぁやだぁ！！助けてぇ！！」",5);
    message2("「なんで…なんでそんなひどいことを…」",5);
    message2("「なぜと言われましてもね…#　好き嫌いなど人それぞれでしょう。#　私たちは少女の悲鳴が大好きなだけですよ。」",5);
    message2("「くっ……………」",4);
    message2("「さてっ！だらだらお話をしていても#　料理が冷めてしまいますからね。#　そろそろディナーショーを始めるとしましょう。」",5);
    message2("男は手に持っていたネズミをケージにしまうと#代わりに何かのリモコンを持ってきた。",5);
    message2("「では、召しあがれ。」",5);
    message2("リモコンのボタンを押すと、#ネズミを隔離していたケージの扉が一斉に開かれた。@中から飛び出てきたネズミはすぐに二人の体を#取り囲み、剥き出しのお尻や背中に登り始めた。",5);
    message2("「ひぃぃ！！#　やだぁ！！取ってぇ！！#　いやぁぁぁ！！！",4);
    message2("腰をくねらせなんとか逃れようとするが、#ねずみ達はどんどん集まっていく。@そして一匹がなよりのふくらはぎに噛み付いた。",4);
    $map.setBGColor(color(100,10,10));
    $cg.a=2;
    $cg2.a=2;
    message2("「い゛っいだぁぁ！？」",4);
    message2("手と首を固定されているため、逃げることもできず、#ぞろぞろと押し寄せてくるネズミたちは#次々と二人の体をむさぼり始めた。",5);
    message2("「ぎゃああああああああああああああああ！！#　いだいいだいいだぁい！！！」",5);
    message2("「ぐぐぅぎぎぃい゛い゛い゛い゛い゛い゛い゛い゛ぃ！！！」",5);
    message2("なよりは目を限界まで見開いて叫び、#りよなは目をぎゅっと閉じ、歯を食いしばっていた。",5);
    message2("「いくら腹を空かせているとはいえ、#一度に齧り取れる肉はそう多くはありませんからね。」@「どうですか？#　少しずつ自分の体が失われていく感覚は？」@「と言っても、もう聞こえてはいませんかね。」",5);
    wait(50);
    message2("耳をつんざくような絶叫と#肉を貪る咀嚼音だけが#　いつまでも部屋に響いていた…",5);
    $cg.a=3;
    $cg2.a=3;
    wait(300);
    message2("１時間ほど経過した。",5);
    $cg.a=4;
    $cg2.a=4;
    wait(250);
    message2("二人の肉体はほとんど原型を留めていなかった。@足の指を食いちぎられ、#　　アキレス腱を引き裂かれ、@太腿に大穴が開き、#　　肛門をこじ開け腸内から食われ、@腹を突き破り、#　　ハラワタを地面にぶちまけていた。",5);
    message2("二人ともすでに悲鳴はあげていなかった。@血の泡を吹きながら#びくびくと痙攣を起こしている。",5);
    message2("「お二人ともまだ生きておりますか？」@「いやぁ、とてもすばらしいショーでした。#　この映像はきっと高値がつきますよ。」",5);
    $cg.a=3;
    $cg2.a=3;
    wait();
  }
  
  if($end==8){
    wait(50);
    message2("なよりは薄暗い通路を、仮面をつけた女に#鎖でつながれ、引きづられるように#歩いていた。",3);
    $cg.a=1;
    $cg2.a=1;
    wait(330);
    message2("目は虚ろで、全身にあざができ、#股にはまだ乾いていない血が#べったりとはりついている。@３日３晩、殴られ、嬲られ、犯され、#なよりの肉体と精神はすでに限界であった。",3);
    message2("「ほら！なよりちゃん！#　しっかり歩きなさい。」",4);
    message2("「ぐげぇ！」",3);
    message2("鎖を思いっきり引っ張られ、#なよりは可笑しな声をあげた。",3);
    message2("「せっかくあいつらから#　買い取ってあげたんだから#　感謝しなさいよね。」@「あなた、あのままいたら#　一週間も生きていられなかったわよ。」",4);
    message2("「まぁそれはそうと、なよりちゃん…#　なんで私があなたを#  助けてあげたか分かるかなぁ？」",4);
    message2("「………」",4);
    message2("「…ちょっとぉ！ちゃんと聞いてる？」@「………」@「…もう、しょうがないわねぇ。#　いま私、りよなちゃんと一緒に#　いるのよ。」@「あの子がいつもあなたのことばかり#　しゃべってるから連れてきてあげるって#　約束したのよ。」@「私ってやさしいでしょ？」",4);
    message2("「…ぉ…ねぇ…ちゃん……？」",4);
    message2("姉の話が出て、#絶望で濁った瞳に生気が戻った。",3);
    message2("「うふふっそうよぉ。感謝しなさい。#　これから、一緒に暮らせるのよ。」",4);
    message2("「…おねぇちゃんに…会…える…」",4);
    message2("しばらく歩くと仮面の女は赤い扉の前で#立ち止まり、鍵を開けて室内へ入っていった。",3);
    $cg.a=0;
    $cg2.a=0;
    wait(60);
    message2("「りよなちゃん！　約束通りなよりちゃん#　連れてきてあげたわよぉ！」",4);
    wait(100);
    message2("「…な……よ…り…？」",4);
    message2("室内に入るのをためらっていたが#中から聞き覚えのある声が聞こえ、#なよりは勢い良く、声のする方へと向かった。",3);
    message2("「お姉ちゃん！そこにいるの！？#　お姉っ！？」",4);
    message2("部屋に入り、りよなを見つけたなよりは#姉のあまりにも異常な姿に、#言葉を失った。",3);
    message2("「おねぇ…ちゃん…なに…その…胸…？」",4);
    $cg.a=2;
    $cg2.a=2;
    wait(250);
    message2("以前は姉妹の胸の差は#ほとんど変わらなかったのだが、#今や倍なんてものではなくなっていた。@りよなの胸は#バスケットボールのように膨れ上がり、#内出血のせいでどす黒く変色していた。",3);
    message2("「うふふっすごいでしょう？#　ここまで大きくするの#　けっこう大変だったんだから。」",4);
    message2("「何…？…どうして…？」",4);
    message2("「お薬で母乳が出るようにしてあげたのよ。#　もっとも、副作用で乳腺や細胞が#　ぐちゃぐちゃになっちゃったんだけどねっ！」",4);
    message2("そう言いながら仮面の女は#りよなの胸の先の一番敏感な部分を小突いた。",3);
    message2("「あぐぅっぁぁ！！」",4);
    message2("りよなは激痛で身を捩じらせ、#胸から黄色く色味のかかった乳液を噴出させる。",3);
    message2("「お姉ちゃん！！」",4);
    message2("なよりは自分の痛みなど忘れて#姉の名を叫んだ。",3);
    message2("「さてと、なよりちゃんには#　一仕事してもらうわよ。」",4);
    message2("そういうと首輪についた鎖と手枷を外された。",3);
    message2("「このお薬を使うと無尽蔵に#　おっぱいを造り出しちゃうから#　定期的に搾らないといけないのよ。」@「今日はまだ一度も搾ってあげてないから#　もう破裂寸前よ。」",4);
    message2("「だーかーら！#　なよりちゃんがお口で#　おっぱいを吸って助けてあげるのよ。」",4);
    message2("「わたしが…」",4);
    message2("「ただし、手で搾っちゃだめよ。#　口で全部吸い取るのよ。」",4);
    message2("りよなの前に立つと、#改めて胸の状態のひどさに#なよりは眉をひそめた。",3);
    message2("「お…お姉ちゃん…だいじょうぶ？」",4);
    message2("「あぁ…なより…#　どこぉ…苦しいぃ苦しいよ…」",4);
    message2("りよなの悲痛なうめきを聞きなよりは決心する。",3);
    message2("「待ってて！お姉ちゃん！#　いま楽にしてあげるから！」",4);
    message2("そう言うと、#なよりはりよなの胸に吸い付いた。",3);
    $cg.a=3;
    $cg2.a=3;
    wait(50);
    message2("「いだぁぁぁぁ！！なよりぃ！！#　やめでぇ！いだい！いだいぃ！！」",4);
    message2("りよなは狂ったように叫び、#体を仰け反らせて#なよりの搾乳から逃れようとした。",3);
    message2("「ぐぷっ…お姉ちゃん…我慢して…#こうしないと…破裂…しちゃう…から…」",4);
    message2("「なよ…っり！！もう…やめ…て…痛い#　…いだっ！！@　…もう…殺してよ…なより…殺しでぇ！！」",4);
    message2("暴れまわるりよなに体を蹴られながらも、#なよりは必死に吸い続けた。",3);
    message2("「あははははっ！いい眺めぇ！！」@「あなた達ほんと最高よ！！#　これでしばらくは楽しめそうだわ。」",4);
    wait(100);
    $map.setBGColor(color(100,10,10));
    $cg.a=4;
    $cg2.a=4;
    wait();
  }
  if($end==12){
    while($denki.alpha>0){
      $denki.alpha=$denki.alpha-(3/2);
      update();
    }
    wait(50);
    message("「この子が、例の食料庫で#　見つかったっていう子ね。」",4);
    message("「ええ、自殺しているところを#　発見いたしましてね。」@「姉の方はだめでしたが、#　妹は脳が無事だったので#　手足を切り落として#　この装置を取り付けました。」",4);
    message("「私、機械苦手だから#　分かんないんだけど、#　これ何やってるの？」",4);
    message("「こちらの装置は#　我が組織で開発した、#　脳に直接情報を送って#　夢を見させる装置です。」@「まぁ夢といっても本人は#　現実と同じ感覚…痛みを感じて#　おりますがね」",4);
    message("「ふーん、#　このモニターの映像は何なの？」",4);
    message("「こちらは現在彼女が見ている#　夢を映像化したものです。」@「だいぶ劣化していますが、#　どうやら今はどなたかに刺されて#　いるようですね。」@「これで既に3000回#　近くは殺されていますよ。」",4);
    message("「ん？#　どういうこと？」",4);
    message("「この装置の良いところは、#　何回死のうが繰り返し#　拷問を疑似体験させることが#　できるんですよ。」",4);
    message("「へえ、#　それはかわいそうに。」",4);
    message("「自殺という形で我々から#　逃れようとした罰ですよ。」@「彼女には脳が焼き切れるまで#　拷問を受けていただきますよ。」",4);
    while($denki.alpha<255){
      $denki.alpha=$denki.alpha+(3/2);
      update();
    }
    wait(50);
    $message=13;
    $projectmanager.loadpage($page_gameover);
  }
  
  update();
}