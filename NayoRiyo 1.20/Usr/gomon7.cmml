<resourcelist name="usr">
 <resourcelist name="patterns">
<cpattern name="$pat_end7_1" src="end7_1.png"/>
<cpattern name="$pat_end7_2" src="end7_2.png"/>
<cpattern name="$pat_end7_3" src="end7_3.png"/>
<cpattern name="$pat_end7_4" src="end7_4.png"/>
<cpattern name="$pat_end7_5" src="end7_5.png"/>
<cpattern name="$pat_end7_6" src="end7_6.png"/>
 </resourcelist>
 <resourcelist name="classes">
 </resourcelist>
 <resourcelist name="gen">
<generator className="cg" name="$cg" inst_angle="0" inst_alpha="255" inst_scalex="1" inst_p="$pat_end7_1+0" inst_zOrder="100" inst_x="250" inst_y="170"/>
<generator className="cg2" name="$cg2" inst_angle="0" inst_alpha="255" inst_scalex="1" inst_p="$pat_end7_2+0" inst_x="250" inst_y="170" inst_zOrder="100"/>
<generator className="gomonkan4" name="$gomonkan4" inst_zOrder="-100" inst_text="%22テキスト%22" inst_bold="1" inst_x="524" inst_y="83"/>
 </resourcelist>
 <resourcelist name="global">
  <globalvalue name="$screenWidth" value="616"/>
  <globalvalue name="$screenHeight" value="342"/>
 </resourcelist>
</resourcelist>
