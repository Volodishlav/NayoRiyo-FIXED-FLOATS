extends SpriteChar;
n=0;
a=0;
i=0;
s=0;
anim=newAnimation();
while(1){
  if($end==1){
    if($se==4 && y<310){
      vx-=(7/10);
      vy+=(1/5);
      x+=vx;
      y+=vy;
    }
    else{
      p=$pat_die_riyona+1;
    }
  }
  if($end==2){
    zOrder=20;
    x=174;
    y=262;
    if(n==1){
      anim.play($pat_die_riyona+4);
      anim.pause();
    }
    if(n==2)anim.loop($pat_die_riyona+3,$pat_die_riyona+4,30);
    if(n==3)anim.loop($pat_die_riyona+3,$pat_die_riyona+4,15);
    if(n==4)anim.loop($pat_die_riyona+5,$pat_die_riyona+6,15);
    if(n==5){
      while(i<10){
        anim.play($pat_die_riyona+6,$pat_die_riyona+7,2);
        update();
        i++;
      }
      if(i>=10){
        p=$pat_die_riyona+6;
        wait(50);
        n=6;  
      }
    }
    if(n==6)anim.loop($pat_die_riyona+6,$pat_die_riyona+7,40);
    if(n==7){
      x=173;
      y=252;
      anim.play($pat_die_riyona+8);
      anim.pause();
    }
    if(n==8){
      x=173;
      y=252;
      anim.loop($pat_die_riyona+9,$pat_die_riyona+10,20);
    }
    if(n==9){
      x=173;
      y=252;
      anim.loop($pat_die_riyona+9,$pat_die_riyona+10,10);
    }
  }
  if($end==(5/2)){
    zOrder=10;
    p=$pat_die_riyona+11;
    x=200;
    y=275;
    if(getkey(2)==1 && $gomonkan2.a!=3){
      $mplayer.play($se_don);
      p=$pat_die_riyona+12;
      updateEx(5);
    }
    if (crashTo( $mouse ) && getkey(1)==1 && $mouse.x-x<10 && $mouse.x-x>-10 && $mouse.y-y<20 && $mouse.y-y>-45){
      $gomonkan2.n=1;
    } 
    if(s<100){
      s++;
    }
  }
  if($end==3){
    anim.play($pat_die_riyona+13);
    anim.pause();
    if(getkey(2)==1 && s==0){
      n=1;  
    }
    if(n==1){
      anim.play($pat_die_riyona+13,$pat_die_riyona+14,15);
      wait(15);
      anim.play($pat_die_riyona+14);
      updateEx(20);
      wait(10);
      $mplayer.play($se_fumi);
      n=0;
    }
    if(n==2){
      p=$pat_die_riyona+16;
      n=3;
    }
    if(n==3){
      x=241;
      y=273;
      anim.loop($pat_die_riyona+16,$pat_die_riyona+17,40);
    }
    if(n==4){
      anim.play($pat_die_riyona+18);
      anim.pause();
      wait(30);
      n=5;
    }
    if(n==5){
      f=-1;
      anim.loop($pat_riyona+40,$pat_riyona+41,70);
    }
    if(n==6){
      x=x+10;
      anim.play($pat_die_riyona+19);
      wait(20);
      anim.play($pat_die_riyona+20);
      n=7;
    }
    if(n==7){
      p=$pat_die_riyona+20;
    }
    if(n==8){
      anim.play($pat_die_riyona+21);
      anim.pause();
    }
    if(n==9){
      $gomonkan.a=1;
      anim.loop($pat_die_riyona+22,$pat_die_riyona+23,20);
    }
    
  }
  
  
  if($end==4){
    anim.loop($pat_riyona+29,$pat_riyona+30,75);
    if(x<=100){
      i=1;
      $die_nayori.i=1;
      $gomonkan3.n=5;
    }
    if(n==6){
      anim.play($pat_riyona+35);
      anim.pause();
    }
    if(n==7){
      anim.play($pat_riyona+36);
      anim.pause();
    }
    if(n==8){
      anim.play($pat_riyona+37);
      updateEx(30);
      
      anim.play($pat_riyona+38);
      n=9;
    }
    if(n==9){
      anim.play($pat_riyona+38);
      anim.pause();
    }
    if(n==10){
      anim.play($pat_riyona+39);
      anim.pause();
    }
    if(n==1){
      if(a==0){
        if(getkey(37)>1 && i!=1){
          x=x-(3/10);
          anim.loop($pat_riyona+31,$pat_riyona+34,30);
        }
        else{
          anim.loop($pat_riyona+29,$pat_riyona+30,75);
        }
      }
    } 
    if(n==5 && a==0){
      $die_nayori.i=1;
      $gomonkan3.n=3;
      $mplayer.play($se_sasaru0);
      anim.play($pat_die_riyona+35);
      updateEx(15);
      x=x+15;
      anim.play($pat_die_riyona+36);
      updateEx(5);
      x=x+15;
      anim.play($pat_die_riyona+37);
      updateEx(50);
      $mplayer.play($se_sasaru);
      anim.play($pat_die_riyona+38);
      updateEx(30);
      a=1;
    }
    if(a==1){
      anim.loop($pat_die_riyona+39,$pat_die_riyona+40,70);    
    }
    if(n==3 && a==0){
      $die_nayori.i=1;
      $mplayer.play($se_kiru);
      anim.play($pat_die_riyona+24);
      updateEx(15);
      anim.play($pat_die_riyona+25);
      updateEx(15);
      anim.play($pat_die_riyona+26);
      updateEx(15);
      $gomonkan3.n=2;
      anim.play($pat_die_riyona+27);
      updateEx(30);
      anim.play($pat_die_riyona+28);
      updateEx(30);
      anim.play($pat_die_riyona+29);
      a=2;
    }
    if(a==2){
      anim.play($pat_die_riyona+29);
      anim.pause();
    }
    if(n==4 && a==2){
      x=x+25;
      $mplayer.play($se_kiru);
      anim.play($pat_die_riyona+30);
      updateEx(30);
      anim.play($pat_die_riyona+31);
      updateEx(30);
      anim.play($pat_die_riyona+32);
      updateEx(30);
      anim.play($pat_die_riyona+33);
      updateEx(50);
      anim.play($pat_die_riyona+34);
      updateEx(30);
      a=3;
    }
    if(a==3){
      $gomonkan3.n=4;
      a=4;
    }
    if(a==4){
      anim.play($pat_die_riyona+34);
      anim.pause();
    } 
  }
  
  if($end==5){
    anim.loop($pat_die_riyona+41,$pat_die_riyona+42,70);
    if(n==1){
      anim.loop($pat_die_riyona+51,$pat_die_riyona+52,10);  
      if(a==0){
        $mplayer.play($se_kanden);  
        wait(100);
      }  
    }
    if(n==2){
      anim.loop($pat_die_riyona+53,$pat_die_riyona+54,7);  
      if(a==0){
        $mplayer.play($se_kanden);  
        wait(80);
      }  
    }    
    if(n==3){
      anim.loop($pat_die_riyona+55,$pat_die_riyona+56,5);  
      if(a==0){
        $mplayer.play($se_kanden);  
        wait(80);
      }  
    }
    if(n==4){
      anim.play($pat_die_riyona+57);
      anim.pause();
    }
    if(n==5){
      anim.play($pat_die_riyona+58);
      wait(200);
      s=1;
      anim.play($pat_die_riyona+59);
      wait(150);
      s=2;
      anim.play($pat_die_riyona+60);
      wait(150);
      s=3;
      anim.play($pat_die_riyona+61);
      wait(150);
      s=4;
      anim.play($pat_die_riyona+62);
      wait(70);
      s=5;
      anim.play($pat_die_riyona+63,$pat_die_riyona+65,70);
      wait();
    }
    if(n==6 && a==0){
      $gomonkan3.n=1;
      anim.play($pat_die_riyona+43);
      updateEx(50);
      anim.play($pat_die_riyona+44);
      updateEx(50);
      a=5;
    }
    if(a==5)anim.loop($pat_die_riyona+44);
    if(n==7)anim.loop($pat_die_riyona+45,$pat_die_riyona+46,7);
    if(n==8)anim.loop($pat_die_riyona+47,$pat_die_riyona+48,7);
    if(n==9)anim.loop($pat_die_riyona+49,$pat_die_riyona+50,7);
    if(n==10){
      anim.play($pat_die_riyona+49);
      anim.pause();
    }
  }
  
  
  if($end==6){
    x=123;
    y=265;
    anim.loop($pat_sonota+7,$pat_sonota+8,50);
    if(n==1 && i<=8){
      anim.play($pat_sonota+10);
      anim.pause();
      if(getkey(2)==1){
        anim.play($pat_sonota+9);
        updateEx(10);
        anim.play($pat_sonota+10);
        anim.pause();
        wait(20);
        i=i+1;
      }
    }
    if(n==1 && i>8 && i<=15){
      anim.play($pat_sonota+12);
      anim.pause();
      if(getkey(2)==1){
        anim.play($pat_sonota+11);
        updateEx(10);
        anim.play($pat_sonota+12);
        anim.pause();
        wait(20);
        i=i+1;
      }
    }
    if(n==1 && i>15){
      anim.play($pat_sonota+13);
      anim.pause();
      if(getkey(2)==1){i=i+1;wait(30);}
    }
    if(n==2){
      anim.play($pat_sonota+13);
      anim.pause();
    }
    if(n==3){
      anim.play($pat_sonota+14);
      anim.pause();
    }
  }
  
  update() ;
}