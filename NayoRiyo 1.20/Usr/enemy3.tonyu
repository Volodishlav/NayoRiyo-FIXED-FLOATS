extends SpriteChar;
anim=newAnimation();
do=0;
heart=3;
zOrder=-20;
while(1){
  if(do==0){
    anim.loop($pat_enemy3+0,$pat_enemy3+3,23);
  }
  if(do==1){
    anim.play($pat_enemy3+5);
  }
  if(do==2){
    anim.loop($pat_enemy3+6,$pat_enemy3+9,23);
  }
  if(do==3){
    anim.loop($pat_enemy3+20,$pat_enemy3+23,23);
  }
  if($nanido==0 && (do==0 || do==2 || do==3 )){
    x=x+(3/5);
  }
  if($nanido==1){
    if($score>=0 && $score<60)x=x+(7/10);
    if($score>=60 && $score<200)x=x+1;
    if($score>=200)x=x+(6/5);
  }
  if($nanido==2){
    if($score>=0 && $score<60)x=x+(4/5);
    if($score>=60 && $score<200)x=x+(6/5);
    if($score>=200)x=x+(3/2);
  }
  if($buki==0){
    if ($target.x-x<25 && $target.x-x>0 && $target.y-y<25 && $target.y-y>0 && do==0) {
      if($target.shoot == 1 ) {
        anim.play($pat_enemy3+16);
        updateEx(10);
        anim.play($pat_enemy3+17);
        updateEx(20);
        $score=$score+1;
        do=3;
      }
    }
    if ( crashTo( $target ) && $target.x-x<-2 && $target.x-x>-40 && $target.y-y<-20 && $target.y-y>-58 && (do==0 || do==2)) {
      if ( $target.shoot == 1 ) {
        heart=heart-1;
        if(heart>=1){
          anim.play($pat_enemy3+4);
          updateEx(5);
          do=1;
        }
        if(heart<=0){
          anim.play($pat_enemy3+10);
          updateEx(10);
          anim.play($pat_enemy3+11);
          updateEx(4);
          anim.play($pat_enemy3+12);
          updateEx(20);
          $score=$score+1;
          do=3;
        }
      }
      if(do==1){
        wait(20);
        do=2;
      }
    }
    if ( crashTo( $target ) && $target.x-x<-10 && $target.x-x>-40 && $target.y-y<-20 && $target.y-y>-58 && (do==3)) {
      if ( $target.shoot == 1 ) {
        $score=$score+1;
        zOrder=-100;
        x=x-30;
        y=y+2;
        anim.play($pat_enemy3+24,5);
        wait(5);
        x=x-15;
        y=y+2;
        anim.play($pat_enemy3+25,5);
        wait(5);
        x=x-20;
        y=y+6;
        anim.play($pat_enemy3+26,5);
        anim.pause();
        wait(30);
        die();
    }}
  }
  if($buki==1){
    if ($target.x-x<50 && $target.x-x>-20 && $target.y-y<80 && $target.y-y>-35 && do==0 && $target.x>=220 && $riyona.si==0) {
      if($target.shoot == 1 ) {
        anim.play($pat_enemy3+18);
        updateEx(10);
        anim.play($pat_enemy3+19);
        updateEx(20);
        do=3;
      }
    }
    if ($target.x-x<30 && $target.x-x>-60 && $target.y-y<-30 && $target.y-y>-70 && (do==0 || do==2) && $target.x>=220) {
      if ( $target.shoot == 1 ) {
        anim.play($pat_enemy3+13);
        updateEx(10);
        anim.play($pat_enemy3+14);
        updateEx(4);
        anim.play($pat_enemy3+15);
        updateEx(20);
        do=3;
      }
    }
    if ($target.x-x<50 && $target.x-x>-60 && $target.y-y<80 && $target.y-y>-70 && (do==3) && $target.x>=220) {
      if ( $target.shoot == 1 ) {
        $score=$score+1;
        zOrder=-100;
        x=x-50;
        anim.play($pat_enemy3+27,5);
        wait(5);
        x=x-30;
        anim.play($pat_enemy3+28,5);
        wait(5);
        x=x-30;
        y=y+10;
        anim.play($pat_enemy3+29,5);
        anim.pause();
        wait(30);
        die();
    }}
  }
  if($buki==2){
    if ( $target.a == 1 ) {
      zOrder=100;
      x=x-50;
      y=y+16;
      if(do==0 || do==1 || do==2){
        anim.play($pat_enemy3+31,5);
        anim.pause();
        wait(30);
        die();
        $target.shoot=0;
        $score=$score+2;
      }
      if(do==3){
        anim.play($pat_enemy3+30,5);
        anim.pause();
        wait(30);
        die();
        $target.shoot=0;
        $score=$score+1;
      }
    }
  }
  
  if($nayori.jigai<2 && $riyona.si<1){
    if(crashTo($nayori) && $nayori.x-x<15 && $nayori.x-x>-15 && (do==0 || do==1 || do==2)){
      if($riyona.asi==1){
        $message=1;
        $projectmanager.loadpage($page_gameover);
      }
      if($riyona.opai>=10){
        $end=8;
        $projectmanager.loadpage($page_gomon8);
      }
      else if($score>=70){
        $end=3;
        $projectmanager.loadpage($page_gomon3);
        if($score>=150 && $nanido!=0){
          $end=6;
          $projectmanager.loadpage($page_gomon6);
        }
      }
      else{
        $message=1;
        $projectmanager.loadpage($page_gameover);
      }  
    }
    if(crashTo($nayori) && $nayori.x-x<-18 && $nayori.x-x>-20 && do==3){
      if($riyona.asi==1){
        $message=1;
        $projectmanager.loadpage($page_gameover);
      }
      if($riyona.opai>=10){
        $end=8;
        $projectmanager.loadpage($page_gomon8);
      }
      else if($score>=70){
        $end=3;
        $projectmanager.loadpage($page_gomon3);
        if($score>=150 && $nanido!=0){
          $end=6;
          $projectmanager.loadpage($page_gomon6);
        }
      }
      else{
        $message=1;
        $projectmanager.loadpage($page_gameover);
      }  
    }
  }
  update(); 
}