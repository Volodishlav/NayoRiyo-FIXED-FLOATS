extends gomonroom;
$screenWidth = 32*(31/2);
$screenHeight = 32*(53/5);
$map.setBGColor(color(50,0,0));
$nanido=0;
$nezumi=0;
$trueend=0;
n=0;
sw=0;

while(1){
  if($end==0){
      if(sw==0){
      darkness(0,0,$screenWidth,$screenHeight);
    wait(30);
  sw=1;  
  }
      if(sw==1){
        fade_in(100);
        sw=2;
        luminous(0,0,$screenWidth,$screenHeight);
      }
  if(n==0){  
    appear(new nanido(100,140,$pat_item+0));
    appear(new nanido(100,210,$pat_item+2));
    appear(new nanido(100,280,$pat_item+4));
    n=1;
  }
}
  
  update();
}