extends SpriteChar;
a=0;
b=0;
n=1;
while(1){
  if($die_riyona.i==0){
    if(n==1){
      a++;
    }
    if(a==300){
      n=2;  
      p=$pat_item+12;
      a=0;
    }
    if(n==2){
      b++;
      if ( $die_riyona.x-x<30  && $die_riyona.x-x>-35){
        $die_riyona.n=5;  
      }
    }
    if(b==270){
      n=1;
      p=$pat_item+11;
      b=0;
    }
  }
  if($die_riyona.i==1){
    p=$pat_item+11;
  }
  update();
}