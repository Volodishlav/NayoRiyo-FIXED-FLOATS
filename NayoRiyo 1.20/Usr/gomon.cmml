<resourcelist name="usr">
 <resourcelist name="patterns">
<cpattern name="$pat_gomonroom" src="gomonroom.png"/>
<cpattern name="$pat_enemy" src="enemy.png"/>
<cpattern name="$pat_die_nayori" src="die_nayori.png"/>
<cpattern name="$pat_die_riyona" src="die_riyona.png"/>
<cpattern name="$pat_kao" src="kao.png"/>
<cpattern name="$pat_sonota" src="sonota.png"/>
<cpattern name="$pat_gomongu" src="gomongu.png"/>
 </resourcelist>
 <resourcelist name="classes">
 </resourcelist>
 <resourcelist name="gen">
<generator className="die_nayori" name="$die_nayori" inst_y="254" inst_p="$pat_die_nayori+2" inst_x="166" inst_zOrder="10" inst_died="0"/>
<generator className="gomonroom" name="$gomonroom" inst_zOrder="1000" inst_p="$pat_gomonroom" inst_x="250" inst_y="170"/>
<generator className="gomonkan" name="$gomonkan" inst_y="241" inst_p="$pat_sonota+1" inst_x="240" inst_zOrder="2"/>
<generator className="gomonkan2" name="$gomonkan2" inst_f="1" inst_p="$pat_enemy+0" inst_bold="1" inst_x="514" inst_y="170" inst_text="%22‰ï˜b%22"/>
<generator className="die_riyona" name="$die_riyona" inst_p="$pat_die_riyona" inst_x="545" inst_y="245" inst_zOrder="10"/>
<generator className="kao" name="$kao" inst_p="$pat_kao+0" inst_y="50" inst_x="41"/>
<generator className="kao2" name="$kao2" inst_f="1" inst_p="$pat_kao+0" inst_y="50" inst_x="451"/>
<generator className="haribote" name="$haribote" inst_x="105" inst_y="220" inst_zOrder="50" inst_p="$pat_die_nayori+5"/>
<generator className="haribote" name="$haribote_3" inst_p="$pat_gomongu+2" inst_zOrder="50" inst_x="260" inst_y="200"/>
<generator className="haribote" name="$haribote_4" inst_zOrder="50" inst_p="$pat_gomongu+0" inst_x="330" inst_y="200"/>
<generator className="gomonkan0" name="$gomonkan0" inst_p="$pat_enemy+0" inst_f="1" inst_zOrder="20" inst_x="430" inst_y="230"/>
 </resourcelist>
 <resourcelist name="global">
  <globalvalue name="$screenWidth" value="656"/>
  <globalvalue name="$screenHeight" value="383"/>
 </resourcelist>
</resourcelist>
