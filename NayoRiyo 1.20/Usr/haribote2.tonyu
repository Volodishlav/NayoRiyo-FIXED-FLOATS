extends SpriteChar;
anim=newAnimation();
a=0;
while(1){
  if($end==(5/2)){
    die();  
  }
  if($end==4){
    if(a==1){
      x=440;  
      y=35;
      if(getkey(37)==1)die();
    }
  }
  
  if($end==6){
    if(a==1){
      x=440;  
      y=35;
      if(getkey(2)==1)die();
    }
  }
  

  update();
}