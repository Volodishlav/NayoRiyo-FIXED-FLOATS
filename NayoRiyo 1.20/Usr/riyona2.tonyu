extends SpriteChar;
anim=newAnimation();
time=300;
x=123;
y=244;
a=0;
flag=0;
while(1){
  if(flag==0){
    anim.play($pat_riyona+42);
    anim.pause();
    time--;
    if(time<0){
      anim.play($pat_riyona+43);
      anim.pause();
      wait(10);
      time=300;
    }
  }else{
    anim.play($pat_riyona+44);
    anim.pause();
  }
  
  if(a==1){
    anim.play($pat_riyona+45);
    anim.pause();
    wait(50);
    anim.play($pat_riyona+46);
    anim.pause();
    wait();
  }
  
  update();
}