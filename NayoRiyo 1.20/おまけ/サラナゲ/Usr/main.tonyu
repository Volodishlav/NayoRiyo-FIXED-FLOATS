extends SpriteChar;

$screenWidth = 32*18;
$screenHeight = 32*9;
while(1){
  if($switch==0){
    $map.setBGColor(color(32,32,32));  
  } 
  if($switch==1){
    $map.setBGColor(color(70,70,150));  
  }

    while($move==2){
    $mplayer.play($se_asi);
    wait(5);
  }    
   if(getkey(82)==1){
    $projectmanager.loadpage($page_index);
  }
  
  update();  
}