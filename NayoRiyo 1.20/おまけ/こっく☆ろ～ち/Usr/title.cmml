<resourcelist name="usr">
 <resourcelist name="patterns">
<cpattern name="$pat_taitle" src="taitle.png"/>
 </resourcelist>
 <resourcelist name="classes">
 </resourcelist>
 <resourcelist name="gen">
<generator className="title" name="$title" inst_p="$pat_taitle+0" inst_x="288" inst_y="208"/>
 </resourcelist>
 <resourcelist name="global">
  <globalvalue name="$screenWidth" value="745"/>
  <globalvalue name="$screenHeight" value="455"/>
 </resourcelist>
</resourcelist>
