extends text;
$se=0;
n=0;
a=0;
i=0;
zOrder=2;
while(1){
  if($end==1){
    wait(100);
    $mplayer.play($se_naguru1);
    wait(100);
    $mplayer.play($se_naguru1);
    $se=1;
    wait(200);
    $kao.sw=3;
    message("ゲホッ！ゲホッ！",7);
    wait(30);
    $kao.sw=1;
    message("もうゆるしてぇ…#死んじゃう…",7);
    $kao.sw=0;
    wait(30);
    $kao2.sw=1;
    message("まだ半分も終わってませんよ。#これくらいで音をあげられても困ります。",3);
    $kao2.sw=0;
    wait(30);
    $kao.sw=2;
    message("うぅ…そんなぁ…@おねえちゃん…たすけて…#おねえちゃん…",7);
    $kao.sw=0;
    wait(30);
    $kao2.sw=1;
    message("おねえちゃん？#…ああそうでした。@あなたのお姉さんなら隣の部屋で#先に罰を受けていたんですよ。",3);
    $kao2.sw=0;
    wait(30);
    $gomonkan0.x=$gomonkan0.x+40;
    $gomonkan0.f=-1;
    $kao2.sw=1;$kao2.f=-1;
    message("おい！お姉さんを持ってきてあげなさい！",3);
    $kao2.sw=0;$kao2.f=1;
    wait(100);
    $se=4;
    wait(20);
    $mplayer.play($se_dosa);
    $gomonkan0.x=$gomonkan0.x-40;
    $gomonkan0.f=1;
    wait(5);
    $kao.sw=1;
    message("ひっ！@なに…ソレ…？",3);
    $kao.sw=0;
    wait(30);
    $kao2.sw=1;
    message("お姉さんに対して#ソレなんて言ったら失礼ですよ。",3);
    $kao2.sw=0;
    wait(30);
    $kao.sw=1;
    message("おねぇ…ちゃん？",8);
    $kao.sw=0;
    wait(30);
    $kao2.sw=1;
    message("いやなかなか見ものでしたよ。@お姉さん、妹の分の罰も受けるから#妹には手を出さないでほしいと#言い出しましてね。",3);
    message("２００発死なずに耐えれれば#妹は助けるという#条件を出してあげたんですよ。@今まで１００発でさえ#生きていた子はいなかったんですが",3);
    message("それをお姉さんはなんと#２１６発も耐えたんですよ。#すごい記録だと思いませんか？@全身の皮膚が裂け、骨が砕け、#内臓を潰しながらも#あなたの名前をつぶやいていましたよ。@いや～#妹を思う気持ちとはすばらしいものですね。",3);
    $kao2.sw=0;
    $kao.sw=2;
    message("ひ…ひどい…ひどい…",5);
    $kao.sw=0;
    wait(30);
    $kao2.sw=1;
    message("まぁそのがんばりを称えて姉の代わりに#あなたに１００発分#ごほうびをあげようと思いましてね。",3);
    $kao2.sw=0;
    wait(30);
    $kao.sw=1;
    message("そんな…おねえちゃん…やだよ…#おねえちゃん！おねえちゃん！",5); 
    $se=2;
    $kao.sw=3;
    message("グエッ！",1);
    $kao.sw=0;
    wait(30);
    $kao2.sw=1;
    message("さて、だらだらやっていても面白くないので#そろそろ再開しますか…",3);
    $kao2.sw=0;
    $kao.sw=2;
    message("おねぇ…ちゃん…おねぇ…",10);
    $se=2;
    $kao.sw=3;
    message("ガハァッ!",1);
    $kao.sw=0;
    wait(80);
    $kao2.sw=1;
    message("はて何発目だったかな？@まぁ１００から数え直しでいいでしょう。",3);
    $kao2.sw=0;
    $se=2;
    $se=5;
    
    wait();
    
  }
  if($end==2){
    wait(50);
    $se=1;
    wait(100);
    message("本当になより…#妹に会わせてくれるんですね？",3);
    wait(30);
    message("ああ約束しよう。#お前が頑張れば頑張るほど#妹にもすぐ会うことができる。",3);
    wait(30);
    message("何を…#すればいいんですか？",3);
    wait(30);
    message("そうだな…@まずはここでオナニーをしてもらおうかな。",3);    
    wait(30);
    message("おなにー？#なんですかそれ…？",3);    
    wait(30);
    message("なんだそんなことも知らないのか。@簡単なことだ。#股を大きく開いて小便の出る所を#指でいじくればいいんだよ。",3);
    wait(30);
    message("！？#そんなこと…",3);
    wait(30);
    message("できないのか？@じゃあしょうがない、#かわりに妹にやらせるだけだ。",3);
    wait(30);
    message("まって！#やります！#やりますから…@なよりには手をださないでください…",3);
    wait(30);
    $die_riyona.n=1;
    wait(50);
    message("…くっ",3);
    wait(50);
    $die_riyona.n=2;
    wait(100);
    message("んんっ…",3);
    wait(50);
    message("もっとはげしくだ…",3);
    wait(30);
    message("はい…",3);
    $die_riyona.n=3;
    wait(100);
    message("くんっ！…",3);
    wait(50);
    $die_riyona.n=4;
    wait(100);
    message("あっぅぅ…！",3);
    wait(100);
    message("んぁぁっ！！",3);
    $die_riyona.n=5;
    wait(100);
    message("はぁ…はぁ…はぁ…",10);
    wait(100);
    $gomonkan.n=1;
    message("そのまま口をあけとけ。",3);
    wait(50);
    $gomonkan.die();
    $die_riyona.n=7;
    wait(10);
    message("んぐっ！？",3);
    wait(30);
    message("噛むなよ。",3);
    wait(30);
    $die_riyona.n=8;
    wait(30);
    message("（何コレ…私…何されてるの…）",3);
    wait(50);
    message("おら！もっと舌をつかえ！",3);
    wait(20);
    $die_riyona.n=9;
    message("むごぉ！！",3);
    wait(100);
    message("(キモチワルイ キモチワルイ キモチワルイ # キモチワルイ キモチワルイ キモチワルイ # キモチワルイ キモチワルイ キモチワルイ)",2);
    wait(50);
    message("(な… よ  り …)",10);
    $se=3;
    wait(100);
    $message=10;
    $projectmanager.loadpage($page_gameover);   
  }
  if($end==(5/2)){
    $se=1;
    if(n==1 && a==0){
      message("・・な・・よ・・・り・・・・・・",7);
      n=0;
      a=1;
    }
    if(n==2 && a==1){
      message("くくっ妹なら#初めからこの部屋にいるのにな…",4);
      n=0;
      a=2;
    }
    if($die_nayori.n==1){
      wait(200);
      a=3;
      $se=5;
      wait();
    }
  }
  if($end==3){
    wait(50);
    $se=1;
    wait(100);
    message("うぅ…",5);
    wait(30);
    message("やっぱりりよなちゃんかわいいっ！#つい興奮して力が入っちゃうわぁ。",4);
    $die_riyona.n=1;
    wait(30);
    message("ぐっ！",3);
    $die_riyona.n=1;
    wait(30);
    message("ぎひっ！",3);
    $die_riyona.n=1;
    wait(30);
    message("がはっ！",3);
    $die_riyona.s=1;
    wait(50);
    message("さてと…#ちょっと休憩しようか。",5);
    $die_riyona.n=2;
    $gomonkan.n=1;
    wait(10);
    message("ゲホッゲホッ",7);
    wait(50);
    message("りよなちゃんはほんとに素直でいい子ね。#この前の競りで#勝ち取った甲斐があったわ。@うふふっ#死ぬまでかわいがってあげるからね。",5);
    wait(30);
    message("はぁ…はぁ…はぁ…",7);
    wait(30);
    message("じゃ３０分後に本格的に始めましょう。",5);
    wait(20);
    $gomonkan.f=-1;
    wait(20);
    $gomonkan.n=2;
    wait(110);
    message("あの…",5);
    $gomonkan.f=1;
    wait(30);
    message("ん？#な～に？",5);
    wait(30);
    message("…その。",5);
    wait(30);
    message("もしかしてなよりちゃんのこと？##会いたいの？",5);
    wait(30);
    message("い…いえ！！#会いたいとかそういうことではなく…@ただ…その…元気に…#してるかなって…@ここのこと忘れて#ちゃんと元の生活に戻れてるか心配で…",5);
    wait(30);
    message("ん～？？それってどういう…@あ！あ～～！！#そういえばそんな約束したようなぁ。@うふふっ、#あんなのウソに決まってるじゃないの。",5);
    wait(20);
    message("え…？どういう…ことですか…@なよりだけは…帰してくれるって…@私が何でもするから#なよりだけは家へ帰してくれるって…#そう約束したじゃないですか。",4);
    wait(30);
    message("私たちのことを知って#生きて帰れる子なんていないわよ。@ただ、りよなちゃんが#何でもしてくれるって言うもんだから#帰したってことにしてたんだけど、#そのことすっかり忘れてたわ。",5);
    wait(30);
    message("そんな…じゃあなよりは…？",5);
    wait(30);
    message("違う部屋で飼ってるわよ。",5);
    wait(30);
    message("うそ…私と同じ…",5);
    wait(30);
    message("なよりちゃんは#あなたと違ってキーキー#うるさいんでちょっと#強いしつけをしてたの。@今はとってもいい子よ。#呼んできてあげる。",5);
    $gomonkan.f=-1;
    $gomonkan.n=5;
    wait(500);
    $gomonkan.f=1;
    $gomonkan.n=8;
    wait(130);
    message("ほら、なよりちゃんおいで。",5);
    wait(50);
    message("おねえ…ちゃん…？",7);
    wait(30);
    message("なより！！そこにいるの！？",5);
    wait(30);
    $die_nayori.n=1;
    wait(150);
    message("あは！やっぱりおねえちゃんだぁ。#どーしたのぅそんなとこにすわりこんでぇ。",7);
    wait(30);
    message("なより…？どうしたの…？#あなた…何かされたの？",5);
    wait(30);
    message("えーわたしぃ？#わたしはねぇいろいろされたよぉ。@しゅじゅつでおっぱいおおきくしたりぃ、#ネコミミつけたりぃ、#あと、ちんちんもつけてもらったんだぁ。",5);
    wait(30);
    message("なより…あなた変よ…#何を…言ってるの？",5);
    wait(30);
    message("それとねぇ、#おなかをひらいてなかのもので#ぐちゅぐちゅしてあそぶのぉ#ぐちゅぐちゅ。",5);
    wait(30);
    message("うふふっ#りよなちゃんが見れないのが残念だけど#なよりちゃんすっごくキュートになったのよ。",5);
    wait(30);
    message("なよりに…#なよりに何したんです！！",5);
    wait(30);
    message("何って、今なよりちゃんが言ったじゃない。#ちょっといじりすぎちゃって#壊れちゃっただけ。",5);
    wait(30);
    message("壊れたって…",5);
    wait(30);
    message("ほら、なよりちゃん。久々に#逢えたんだからお姉ちゃんに#その大きく腫れあがったモノを#つっこんであげなさい。",5);
    wait(30);
    message("はぁーい。",5);
    $die_nayori.n=3;
    wait(200); 
    message("な…より…？",5);
    wait(30);
    message("おねえちゃん。",5);
    message("あ そ ぼ ☆",15);
    $die_nayori.x=530;
    $die_riyona.n=6;
    message("きゃっ！！",5);
    wait(30);
    message("なより！やだっ！やめて！",5);
    wait(30);
    message("あれれぇ？おねえちゃんのあなじゃ#ちいさくてさけちゃうかもぉ。@でもそれがきもちいいかもぉ。",5);
    $die_riyona.n=8;
    wait(30);
    message("痛っ！なよりやめてっ！痛い痛いぃ！！",5);
    $die_riyona.n=9;
    wait(30);
    message("あはぁおねえちゃんいたいのぉ？#わたしはきもちいいよぉ",5);
    wait(30);
    message("あぁんいいわぁ！姉妹愛ってやつねぇ～。@また濡れてきちゃったわ。@とうぶんこれで楽しめそうね。",5);
    wait(100);
    $se=5;
    wait();
  }
  update();
  
}
