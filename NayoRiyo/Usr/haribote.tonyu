extends SpriteChar;
anim=newAnimation();
a=0;
while(1){
  if($end==5){
    zOrder=30;
    if(a==0)anim.loop($pat_item+17,$pat_item+18,2);
    if($die_nayori.n==13 && y<250){
      y=y+(1/10);
    }
    if(y>=250){
      anim.play($pat_item+17);
      anim.pause();
    }
  }
  
  if($end==6){
    zOrder=30;
    if(y<290){
      y=y+2;
      x=x-4;
    }
    if($die_nayori.a==4){
      anim.play($pat_sonota+22,$pat_sonota+24,10);
      wait();
    }
  }
  
  if($end==10){
    anim.loop($pat_nayori+5,$pat_nayori+6,70);
  }
  
  update();
}