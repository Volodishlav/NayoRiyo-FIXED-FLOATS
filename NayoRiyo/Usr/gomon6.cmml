<resourcelist name="usr">
 <resourcelist name="patterns">
<cpattern name="$pat_gomonroom2" src="gomonroom2.png"/>
<cpattern name="$pat_nayori" src="nayori.png"/>
<cpattern name="$pat_sonota" src="sonota.png"/>
<cpattern name="$pat_enemy" src="enemy.png"/>
<cpattern name="$pat_blood" src="blood.png"/>
 </resourcelist>
 <resourcelist name="classes">
 </resourcelist>
 <resourcelist name="gen">
<generator className="gomonroom" name="$gomonroom" inst_p="$pat_gomonroom2+0" inst_zOrder="1000" inst_x="250" inst_y="170" inst_f="-1"/>
<generator className="die_nayori" name="$die_nayori" inst_zOrder="10" inst_f="-1" inst_p="$pat_nayori+22" inst_x="150" inst_y="258"/>
<generator className="die_riyona" name="$die_riyona" inst_y="265" inst_x="123" inst_zOrder="20" inst_p="$pat_sonota+7"/>
<generator className="gomonkan" name="$gomonkan" inst_f="1" inst_zOrder="10" inst_p="$pat_sonota+6" inst_x="240" inst_y="220"/>
<generator className="gomonkan3" name="$gomonkan3" inst_p="6" inst_bold="1" inst_x="523" inst_y="175"/>
<generator className="haribote2" name="$haribote2" inst_p="$pat_sonota+26" inst_x="570" inst_y="274"/>
<generator className="blood" name="$blood" inst_p="$pat_blood+7" inst_x="533" inst_y="312"/>
 </resourcelist>
 <resourcelist name="global">
  <globalvalue name="$screenWidth" value="560"/>
  <globalvalue name="$screenHeight" value="381"/>
 </resourcelist>
</resourcelist>
