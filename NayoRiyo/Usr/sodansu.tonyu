extends SpriteChar;
$tama=6;
$tama2=3;
$tama3=1;
while(1){
  if($buki==0){
    if($tama==6)p=$pat_tama+0;
    if($tama==5)p=$pat_tama+1;
    if($tama==4)p=$pat_tama+2;
    if($tama==3)p=$pat_tama+3;
    if($tama==2)p=$pat_tama+4;
    if($tama==1)p=$pat_tama+5;
    if($tama==0)p=$pat_tama+6;
  }
  if($buki==1){
    if($tama2==3)p=$pat_tama+7;  
    if($tama2==2)p=$pat_tama+8;
    if($tama2==1)p=$pat_tama+9;
    if($tama2==0)p=$pat_tama+10;
  }
  if($buki==2){
    if($tama3==1)p=$pat_tama+11;
    if($tama3==0)p=$pat_tama+12;
  }
  update();
}